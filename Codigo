import numpy as np
import matplotlib.pyplot as plt


def f(t, y):
    return y**2


def y_exacta(t):
    return 1 / (1 - t)


t0 = 0
y0 = 1
tf = 1
h = 0.2

t_values = np.arange(t0, tf + h, h)
y_euler = np.zeros(len(t_values))


y_euler[0] = y0


for i in range(1, len(t_values)):
    y_euler[i] = y_euler[i-1] + h * f(t_values[i-1], y_euler[i-1])


y_vals_exacta = y_exacta(t_values)


print("t\tEuler\tExacta")
for t, ye, ye_exact in zip(t_values, y_euler, y_vals_exacta):
    print(f"{t:.1f}\t{ye:.4f}\t{ye_exact:.4f}")


plt.plot(t_values, y_euler, 'o-', label='Euler aproximado')
plt.plot(t_values, y_vals_exacta, 'r--', label='Solución exacta')
plt.xlabel('t')
plt.ylabel('y(t)')
plt.title('Método de Euler vs Solución Exacta')
plt.legend()
plt.grid(True)
plt.show()
